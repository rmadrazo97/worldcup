# Copy to .env.local (gitignored) and fill in values from
# Firebase Console → Project Settings → Your apps → Web app config.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=worldcup-live-scores-2026
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# Optional — enables Firebase Analytics (GA4) in production builds only.
VITE_FIREBASE_MEASUREMENT_ID=

# Public reCAPTCHA Enterprise site key — safe in the client bundle.
VITE_RECAPTCHA_KEY=

# Region for httpsCallable; must match REGION in functions/src/config.ts.
VITE_FUNCTIONS_REGION=us-central1

# Set to "true" in local dev to wire the JS SDK to the emulator suite.
VITE_USE_EMULATORS=false

# Default season; can be overridden per visit via ?season=2018|2022 in the URL.
VITE_DEFAULT_SEASON=2026

# ── Monetization (Google AdSense) ───────────────────────────────────────────
# Master kill switch. Set to "false" to disable ad loading entirely (no script
# fetched, no slots rendered) without redeploying — handy if a live match is
# affected by an AdSense outage.
VITE_ADS_ENABLED=true

# AdSense Publisher ID (format: ca-pub-XXXXXXXXXXXXXXXX). Optional — the
# production publisher ID is baked into the build (see DEFAULT_CLIENT_ID in
# src/api/ads.js and the verification <script> in index.html). Set this only
# to override (e.g. a second AdSense account in a test environment).
VITE_ADSENSE_CLIENT_ID=

# Slot IDs created in the AdSense dashboard (10-digit numeric strings).
# One per placement. Leaving a slot blank disables just that placement.
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_GROUP=
VITE_ADSENSE_SLOT_MATCH=
