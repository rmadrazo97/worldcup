# Copy to .env.local (gitignored) and fill in values from
# Firebase Console → Project Settings → Your apps → Web app config.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=worldcup-live-scores-2026
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Public reCAPTCHA Enterprise site key — safe in the client bundle.
VITE_RECAPTCHA_KEY=

# Region for httpsCallable; must match REGION in functions/src/config.ts.
VITE_FUNCTIONS_REGION=us-central1

# Set to "true" in local dev to wire the JS SDK to the emulator suite.
VITE_USE_EMULATORS=false

# Default season; can be overridden per visit via ?season=2018|2022 in the URL.
VITE_DEFAULT_SEASON=2026
